# Backend configuration. Copy to .env for local development; in Azure these are
# App Service settings, with the secrets resolved from Key Vault (see
# infra/azure/modules/appServiceSettings.bicep).
#
# settings.py also reads the repository-root .env, so you can keep shared
# secrets there instead of duplicating them here.

# --- Core ---------------------------------------------------------------
# Signs sessions and JWTs. Required in every deployed environment: without it
# the app falls back to the insecure dev key committed in settings.py.
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Database -----------------------------------------------------------
# Unset locally, which falls back to db.sqlite3.
# POSTGRES_HOST=
# POSTGRES_DB=coaching
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# --- Email --------------------------------------------------------------
# Backend selection order: EMAIL_BACKEND > RESEND_API_KEY > EMAIL_HOST >
# console. With none of these set, invitation emails are printed to the console
# and never delivered - which is fine locally and a misconfiguration anywhere else.
RESEND_API_KEY=

# The sender domain must be verified in Resend. The onboarding@resend.dev
# sandbox sender only delivers to the Resend account owner's own address.
DEFAULT_FROM_EMAIL=Coaching Platform <noreply@successby1000cuts.com>

# SMTP alternative to Resend (ignored when RESEND_API_KEY is set).
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true

# --- Links in outbound email --------------------------------------------
# Must be the public URL of the SPA, or invitations point at localhost.
FRONTEND_BASE_URL=http://localhost:5173
# The SPA has no client-side router - it reads ?token= from the root URL - so
# this points at the site root, not a /activate path.
ACCOUNT_ACTIVATION_URL=http://localhost:5173/
# ACCOUNT_ACTIVATION_TOKEN_TTL_HOURS=72

# --- Seeded admin user --------------------------------------------------
# DJANGO_ADMIN_USERNAME=admin
# DJANGO_ADMIN_PASSWORD=

# Uploaded coaching resources; /home/media on App Service (persistent storage).
# MEDIA_ROOT=
